{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jonathanma-assistant-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://jonathanma03.github.io",
    "OPENAI_MODEL": "gpt-6-luna"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "21703",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
